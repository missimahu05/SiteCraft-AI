# ==============================================================================
# SITECRAFT-AI - VARIABLES D'ENVIRONNEMENT OFFICIELLES
# ==============================================================================

# 1. BASE DE DONNÉES (MongoDB Atlas ou Local)
# Remplace SQLite par MongoDB. Si vide, bascule automatique en mémoire pour dev.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sitecraft?retryWrites=true&w=majority

# 2. DÉPLOIEMENT CLOUDFLARE PAGES (Remplacement Vercel)
# Créez un token sur https://dash.cloudflare.com/profile/api-tokens (Permissions: Cloudflare Pages: Edit)
CLOUDFLARE_API_TOKEN=votre_token_cloudflare_pages
CLOUDFLARE_ACCOUNT_ID=votre_account_id_cloudflare

# 3. PAIEMENTS FEEXPAY (Afrique Mobile Money MTN, Moov, Orange, Wave & CB)
# Obtenez vos clés sur https://feexpay.me
FEEXPAY_API_KEY=fp_live_xxxxxxxxxxxxxxxxxxxxxxxxxx
FEEXPAY_SHOP_ID=votre_shop_id_feexpay
FEEXPAY_MODE=TEST # Passez à LIVE pour encaisser réellement

# 4. INTELLIGENCE ARTIFICIELLE MULTIMODALE (Vision LLM & Text)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. CONFIGURATION SYSTÈME
PORT=3001
NODE_ENV=development
